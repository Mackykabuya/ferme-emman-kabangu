---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { t } from '../../i18n';
import { localeStaticPaths } from '../../i18n/paths';
import { config } from '../../config';
export function getStaticPaths() { return localeStaticPaths(); }
const { locale } = Astro.props;
const d = t(locale);
---
<BaseLayout locale={locale} title={d.contact.title} page="contact">
  <div class="wrap pt-14 grid lg:grid-cols-[1fr_18rem] gap-12">
    <div>
      <h1 class="text-4xl lg:text-5xl font-extrabold">{d.contact.title}</h1>
      <p class="mt-4 mb-8 max-w-prose">{d.contact.lead}</p>
      <ContactForm locale={locale} />
    </div>
    <aside>
      <h2 class="text-xl font-bold">{d.contact.where}</h2>
      <p class="mt-2">{config.location[locale === 'en' ? 'en' : 'fr']}</p>
      {config.phone && <p><a class="underline" href={`tel:${config.phone.replace(/\s/g, '')}`}>{config.phone}</a></p>}
      {config.whatsapp && <p class="mt-3"><a class="btn btn-ligne text-feuille" href={`https://wa.me/${config.whatsapp}`}>WhatsApp</a></p>}
    </aside>
  </div>
  <script>
    // Pré-remplit le sujet et la culture depuis l'adresse (?sujet=achat&culture=Tomate)
    const p = new URLSearchParams(location.search);
    const s = document.getElementById('c-subject') as HTMLSelectElement | null;
    if (s && p.get('sujet') && [...s.options].some((o) => o.value === p.get('sujet'))) s.value = p.get('sujet')!;
    const c = p.get('culture'); const m = document.getElementById('c-message') as HTMLTextAreaElement | null;
    const tpl = document.getElementById('contact-form')?.dataset.order;
    if (c && m && tpl && !m.value) m.value = tpl.replace('{crop}', c);
  </script>
</BaseLayout>
