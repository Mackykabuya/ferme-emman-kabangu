---
import '../styles/global.css';
import { t, locales, localePath, switchPath, type Locale } from '../i18n';
import { config } from '../config';
interface Props { locale: Locale; title?: string; description?: string; page?: string; noindex?: boolean }
const { locale, title, description, page = '', noindex = false } = Astro.props;
const d = t(locale);
const site = Astro.site!.toString().replace(/\/$/, '');
const current = Astro.url.pathname;
const fullTitle = title ? `${title} | ${config.name}` : `${config.name}`;
const desc = description ?? d.meta.description;
const canonical = site + localePath(locale, page);
const og = site + '/og.png';
const links = [
  ['', d.nav.home], ['cultures', d.nav.crops], ['technologie', d.nav.tech],
  ['partenaires', d.nav.partners], ['actualites', d.nav.news], ['contact', d.nav.contact],
] as const;
const isActive = (p: string) => current.replace(/\/$/, '') === localePath(locale, p);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Farm', name: config.name, url: site,
  address: { '@type': 'PostalAddress', addressLocality: 'Kinshasa', addressCountry: 'CD' },
  ...(config.email ? { email: config.email } : {}), ...(config.phone ? { telephone: config.phone } : {}),
};
---
<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l === 'fr' ? 'fr-CD' : l} href={site + localePath(l, page)} />)}
    <link rel="alternate" hreflang="x-default" href={site + localePath('fr', page)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f2a1d" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded">{d.nav.skip}</a>
    <header class="bg-seve text-white">
      <div class="wrap flex items-center justify-between gap-4 py-3">
        <a href={localePath(locale)} class="font-display font-bold text-lg tracking-tight">{config.name}</a>
        <nav aria-label={d.nav.main} class="hidden lg:flex items-center gap-1">
          {links.map(([p, label]) => (
            <a href={localePath(locale, p)} aria-current={isActive(p) ? 'page' : undefined} class={`px-3 py-2 rounded hover:bg-white/10 ${isActive(p) ? 'underline underline-offset-8 decoration-cuivre decoration-2' : ''}`}>{label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <label class="sr-only" for="lang">{d.nav.language}</label>
          <select id="lang" class="bg-seve-2 text-white border border-white/30 rounded px-2 py-2 text-sm" onchange="location.href=this.value">
            {locales.map((l) => <option value={switchPath(current, l)} selected={l === locale}>{t(l).label}</option>)}
          </select>
          <a href={config.appUrl} class="btn btn-cuivre hidden sm:inline-flex !py-2 text-sm" rel="noopener">{d.nav.farmSpace}</a>
          <button id="menu-btn" class="lg:hidden btn btn-ligne !py-2 text-sm" aria-expanded="false" aria-controls="menu-mobile">{d.nav.menu}</button>
        </div>
      </div>
      <nav id="menu-mobile" aria-label={d.nav.main} class="lg:hidden hidden border-t border-white/15">
        <div class="wrap py-2 flex flex-col">
          {links.map(([p, label]) => <a href={localePath(locale, p)} class="py-3 border-b border-white/10">{label}</a>)}
          <a href={config.appUrl} class="py-3">{d.nav.farmSpace}</a>
        </div>
      </nav>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="bg-seve text-white/90 mt-24">
      <div class="wrap py-12 grid gap-10 md:grid-cols-3">
        <div>
          <p class="font-display font-bold text-xl text-white">{config.name}</p>
          <p class="mt-3 max-w-sm">{d.footer.about}</p>
        </div>
        <div>
          <p class="font-display font-semibold text-white">{d.footer.explore}</p>
          <ul class="mt-3 space-y-1">{links.map(([p, label]) => <li><a class="hover:underline" href={localePath(locale, p)}>{label}</a></li>)}</ul>
        </div>
        <div>
          <p class="font-display font-semibold text-white">{d.footer.contactTitle}</p>
          <ul class="mt-3 space-y-1">
            <li>{config.location[locale === 'fr' || locale === 'en' ? locale : 'fr']}</li>
            {config.phone && <li><a class="hover:underline" href={`tel:${config.phone.replace(/\s/g, '')}`}>{config.phone}</a></li>}
            {config.email && <li><a class="hover:underline" href={`mailto:${config.email}`}>{config.email}</a></li>}
            {config.whatsapp && <li><a class="hover:underline" href={`https://wa.me/${config.whatsapp}`}>WhatsApp</a></li>}
            <li><a class="hover:underline" href={config.appUrl} rel="noopener">{d.footer.farmSpace}</a></li>
          </ul>
        </div>
      </div>
      <p class="wrap pb-8 text-sm text-white/60">© {new Date().getFullYear()} {config.name}. {d.footer.rights}</p>
    </footer>
    <script is:inline>
      var b = document.getElementById('menu-btn'), m = document.getElementById('menu-mobile');
      b && b.addEventListener('click', function () { var o = m.classList.toggle('hidden') === false; b.setAttribute('aria-expanded', String(o)); });
    </script>
  </body>
</html>
