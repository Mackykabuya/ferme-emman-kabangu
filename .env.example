# Copiez ce fichier en « .env » et remplissez-le. Ne le partagez jamais.
FERME_DOMAINE=ferme.exemple.com
POSTGRES_PASSWORD=changez-moi-longue-phrase
# Mot de passe du premier compte admin (sinon un mot de passe aléatoire s'affiche une fois dans les journaux)
ADMIN_MOT_DE_PASSE=
FERME_HTTPS=1
# Capteurs simulés : 5 = le temps passe vite ; 0 = simulation coupée (pour de vrais capteurs plus tard)
SIMULATION_SECONDES=5
# Sauvegardes : toutes les 24 h, 14 copies gardées
SAUVEGARDE_HEURES=24
SAUVEGARDE_GARDER=14
# Alertes par e-mail (demandent la section SMTP ci-dessous) : vérification toutes les 5 min (0 = coupé),
# rappel toutes les 12 h si le problème dure (0 = jamais), rôle minimum des destinataires
NOTIF_MINUTES=5
NOTIF_RAPPEL_H=12
NOTIF_ROLE_MIN=agronome

# --- Connexion par e-mail et « mot de passe oublié » ---
# E-mail du compte administrateur (sert à se connecter ; ajouté à un compte existant s'il n'en a pas)
ADMIN_EMAIL=
# Adresse publique du site, utilisée dans les liens envoyés par e-mail (sans elle, aucun lien n'est envoyé)
FERME_URL=https://ferme.exemple.com
# Envoi des e-mails (SMTP). Sans SMTP_HOTE, le lien est écrit dans le journal du serveur
# et l'administrateur peut le générer depuis Mon compte > Comptes utilisateurs.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_DE=
# SMTP_SSL=1 pour le port 465 ; SMTP_STARTTLS=0 pour désactiver STARTTLS
REINIT_MINUTES=60
